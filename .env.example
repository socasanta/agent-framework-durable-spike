# Local DTS emulator defaults; these can be omitted locally.
ENDPOINT=http://localhost:8080
TASKHUB=default

# Keep this stable for every worker that may resume an in-flight instance.
WORKFLOW_VERSION=1.0.0

# Azure only: set by the deployment script for the user-assigned identity.
# AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
